{
  "id": "dingtalk-bridge",
  "name": "DingTalk Bridge",
  "description": "DingTalk ordinary-account channel using a local bridge.",
  "categories": [
    "channels"
  ],
  "channels": [
    "dingtalk-bridge"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expectedRelease": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "Optional exact plugin package version required for this deployment."
      }
    }
  },
  "channelConfigs": {
    "dingtalk-bridge": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "python": {
            "type": "string",
            "minLength": 1
          },
          "bridgeRoot": {
            "type": "string",
            "minLength": 1
          },
          "pollIntervalMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "bridgePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "consumerInstance": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "maxLength": 32
                },
                "bridgeAccountId": {
                  "type": "string",
                  "minLength": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "routes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "conversationId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "conversationType": {
                        "enum": [
                          "direct",
                          "group"
                        ]
                      },
                      "allowSenders": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "initialCursor": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "groupReplyMode": {
                        "enum": [
                          "command",
                          "mention",
                          "always",
                          "agent-decides"
                        ],
                        "description": "Group routes only. Defaults to command."
                      },
                      "groupReplyPrompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "description": "Operator participation preference for agent-decides groups."
                      }
                    },
                    "required": [
                      "conversationId",
                      "conversationType",
                      "allowSenders",
                      "initialCursor"
                    ]
                  }
                },
                "githubPullRequests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "repositories"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "snapshot",
                        "public-api"
                      ]
                    },
                    "repositories": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                      }
                    },
                    "snapshotDirectory": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "required": [
                "bridgeAccountId",
                "routes"
              ]
            }
          }
        },
        "required": []
      }
    }
  },
  "contracts": {
    "tools": [
      "dingtalk_github_pull_request"
    ]
  }
}
